<UserControl x:Class="schedule.Views.GanttView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 圖例 + 縮放 -->
        <DockPanel Margin="2,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="13" Margin="0,0,8,0"
                        ToolTip="捲動到今天" Click="Today_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="今天"/>
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource SegmentBar}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ZoomDay" Style="{StaticResource SegmentTab}" GroupName="GanttZoom" Tag="Day"
                                     Content="日" Padding="12,4" IsChecked="True" Checked="Zoom_Checked"/>
                        <RadioButton Style="{StaticResource SegmentTab}" GroupName="GanttZoom" Tag="Week"
                                     Content="週" Padding="12,4" Checked="Zoom_Checked"/>
                        <RadioButton Style="{StaticResource SegmentTab}" GroupName="GanttZoom" Tag="Month"
                                     Content="月" Padding="12,4" Checked="Zoom_Checked"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <WrapPanel VerticalAlignment="Center">
                <WrapPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,14,0"/>
                    </Style>
                </WrapPanel.Resources>
                <Border Width="22" Height="10" CornerRadius="3" Margin="0,0,6,0" BorderThickness="1"
                        Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"/>
                <TextBlock Text="預計：材料入場 → 配電"/>
                <Border Width="22" Height="10" CornerRadius="3" Margin="0,0,6,0" Background="{DynamicResource AccentBrush}"/>
                <TextBlock Text="預計：配電 → 交期"/>
                <Border Width="22" Height="5" CornerRadius="2" Margin="0,0,6,0" Background="{DynamicResource SuccessBrush}"/>
                <TextBlock Text="實際完成"/>
                <Rectangle Width="8" Height="8" Margin="0,0,6,0" Fill="{DynamicResource DangerBrush}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <TextBlock Text="逾期未完成"/>
                <Rectangle Width="2" Height="12" Margin="0,0,6,0" Fill="{DynamicResource DangerBrush}"/>
                <TextBlock Text="今天"/>
            </WrapPanel>
        </DockPanel>

        <!-- 圖表：左邊工令欄、上方日期列固定，其餘可上下左右捲動 -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12">
            <Grid x:Name="ChartGrid" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,1" CornerRadius="11,0,0,0">
                    <TextBlock Text="工令" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Bottom" Margin="14,0,0,8"/>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" CornerRadius="0,11,0,0">
                    <ScrollViewer x:Name="HeaderScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <Canvas x:Name="HeaderCanvas" Height="49"/>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer x:Name="NameScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                                  Focusable="False" PreviewMouseWheel="NameScroll_PreviewMouseWheel">
                        <Canvas x:Name="NameCanvas" MouseLeftButtonDown="Canvas_MouseLeftButtonDown" Background="Transparent"/>
                    </ScrollViewer>
                </Border>

                <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="BodyScroll_ScrollChanged" PreviewMouseWheel="BodyScroll_PreviewMouseWheel">
                    <Canvas x:Name="BodyCanvas" MouseLeftButtonDown="Canvas_MouseLeftButtonDown" Background="Transparent"/>
                </ScrollViewer>

                <!-- 沒有資料時的提示 -->
                <TextBlock x:Name="EmptyText" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" LineHeight="20" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
