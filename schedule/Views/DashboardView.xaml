<UserControl x:Class="schedule.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 上方的數字方塊 -->
        <Style x:Key="KpiTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="KpiNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="KpiSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- 下方的區塊 -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14,16,10"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PanelHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,1,0,0"/>
        </Style>
        <Style x:Key="EmptyHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="2,4,0,10"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- 橫向長條（人員、客戶）：點一下用名稱搜尋 -->
        <DataTemplate x:Key="BarTemplate">
            <Button Style="{StaticResource CardButton}" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}">
                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="6,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Grid Grid.Column="1" Height="10" VerticalAlignment="Center">
                            <Border CornerRadius="5" Background="{DynamicResource HoverBrush}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Fill}"/>
                                    <ColumnDefinition Width="{Binding Rest}"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="5" Background="{DynamicResource AccentBrush}"/>
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0" ButtonBase.Click="Card_Click">
            <!-- ===== 數字方塊 ===== -->
            <Grid Margin="0,0,-10,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <TextBlock Text="未交貨工令" Style="{StaticResource KpiLabel}"/>
                        <TextBlock x:Name="ActiveText" Style="{StaticResource KpiNumber}" Foreground="{DynamicResource AccentTextBrush}"/>
                        <TextBlock x:Name="ActiveSub" Style="{StaticResource KpiSub}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <TextBlock Text="逾期" Style="{StaticResource KpiLabel}"/>
                        <TextBlock x:Name="OverdueText" Style="{StaticResource KpiNumber}" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="有項目過了預計日期" Style="{StaticResource KpiSub}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <TextBlock Text="7 天內交貨" Style="{StaticResource KpiLabel}"/>
                        <TextBlock x:Name="DueSoonText" Style="{StaticResource KpiNumber}" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock x:Name="DueSoonSub" Style="{StaticResource KpiSub}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <TextBlock x:Name="MonthLabel" Text="本月已交貨" Style="{StaticResource KpiLabel}"/>
                        <TextBlock x:Name="MonthText" Style="{StaticResource KpiNumber}" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock x:Name="MonthSub" Style="{StaticResource KpiSub}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <TextBlock Text="準時交貨率" Style="{StaticResource KpiLabel}"/>
                        <TextBlock x:Name="OnTimeText" Style="{StaticResource KpiNumber}"/>
                        <TextBlock x:Name="OnTimeSub" Style="{StaticResource KpiSub}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <TextBlock Text="全部工令" Style="{StaticResource KpiLabel}"/>
                        <TextBlock x:Name="TotalText" Style="{StaticResource KpiNumber}"/>
                        <TextBlock x:Name="TotalSub" Style="{StaticResource KpiSub}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== 逾期項目 ===== -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="逾期未完成" Style="{StaticResource PanelTitle}"/>
                            <TextBlock x:Name="OverdueHint" Style="{StaticResource PanelHint}"/>
                        </StackPanel>
                        <TextBlock x:Name="OverdueEmpty" Text="沒有逾期的項目" Style="{StaticResource EmptyHint}"/>
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="OverdueList" ItemTemplate="{StaticResource EventCard}" Margin="0,0,4,0"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ===== 接下來 7 天 ===== -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Panel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="接下來 7 天" Style="{StaticResource PanelTitle}"/>
                            <TextBlock x:Name="UpcomingHint" Style="{StaticResource PanelHint}"/>
                        </StackPanel>
                        <TextBlock x:Name="UpcomingEmpty" Text="接下來 7 天沒有排定的項目" Style="{StaticResource EmptyHint}"/>
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="UpcomingList" ItemTemplate="{StaticResource EventCard}" Margin="0,0,4,0"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ===== 未來 8 週交貨 ===== -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="未來 8 週交貨" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="每週預計交貨、還沒交的工令數" Style="{StaticResource PanelHint}"/>
                        </StackPanel>
                        <ItemsControl x:Name="WeekChart" Height="170">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0" Background="Transparent" ToolTip="{Binding ToolTip}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="{Binding Rest}"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="{Binding Fill}"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="1" Text="{Binding Count}" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                            <Border x:Name="Bar" Grid.Row="2" CornerRadius="6,6,2,2" Background="{DynamicResource AccentSoftBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" MaxWidth="44"/>
                                        </Grid>
                                        <Border Grid.Row="2" Height="1" Background="{DynamicResource LineBrush}" VerticalAlignment="Top" Margin="-4,0"/>
                                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                            <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="11.5" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="SubLabel" Text="{Binding SubLabel}" FontSize="11" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource SubtleBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="WeekNote" FontSize="12" Foreground="{DynamicResource DangerBrush}" Margin="2,10,0,4"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ===== 人員負荷 ===== -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="配電人員負荷" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="盤內 + 盤外，未交貨的工令數" Style="{StaticResource PanelHint}"/>
                        </StackPanel>
                        <TextBlock x:Name="WorkloadEmpty" Text="未交貨的工令都還沒填配電人員" Style="{StaticResource EmptyHint}"/>
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="WorkloadList" ItemTemplate="{StaticResource BarTemplate}" Margin="-6,0,4,0"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ===== 客戶 ===== -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE821;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="客戶" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="未交貨的工令數" Style="{StaticResource PanelHint}"/>
                        </StackPanel>
                        <TextBlock x:Name="CustomerEmpty" Text="未交貨的工令都還沒填客戶" Style="{StaticResource EmptyHint}"/>
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CustomerList" ItemTemplate="{StaticResource BarTemplate}" Margin="-6,0,4,0"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ===== 最近交貨 ===== -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Panel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="最近交貨" Style="{StaticResource PanelTitle}"/>
                        </StackPanel>
                        <TextBlock x:Name="RecentEmpty" Text="還沒有交貨紀錄" Style="{StaticResource EmptyHint}"/>
                        <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource EventCard}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
