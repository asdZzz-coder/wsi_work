<Window x:Class="schedule.Views.MaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:schedule.Views"
        Title="大倉庫" Height="820" Width="1300" MinHeight="560" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,8,0"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- 物料清單的一列。欄寬與上方標題列一致，改欄寬時兩邊都要改 -->
        <DataTemplate x:Key="MaterialTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Focusable="False"
                          AutomationProperties.Name="{Binding CheckName}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding Material.PartNo}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding Material.Name}"/>
                <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding Material.Spec}" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding Material.Unit}"/>
                <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Text="{Binding Material.Category}" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel x:Name="PickPart" Grid.Column="6" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBox Width="76" Padding="8,5" FontSize="13" TextAlignment="Right" Margin="0,0,6,0"
                             Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="數量"
                             ToolTip="出料數量；打數字會自動勾選"/>
                    <Border Width="64" VerticalAlignment="Center">
                        <Border x:Name="InDispatchChip" Style="{StaticResource StateChip}" Tag="Done" HorizontalAlignment="Left"
                                Visibility="Collapsed" ToolTip="這張工令的出料紀錄已經有這個料號">
                            <TextBlock Text="已出料"/>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPick}" Value="True">
                    <Setter TargetName="PickPart" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding InDispatch}" Value="True">
                    <Setter TargetName="InDispatchChip" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 標題與工具列 ===== -->
        <DockPanel Margin="0,0,0,14">
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Click="Paste_Click" AutomationProperties.Name="從剪貼簿貼上"
                            ToolTip="在 Excel 選好物料（可以含標題列：料號、名稱、規格、單位、分類）按 Ctrl+C，再按這裡">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="從剪貼簿貼上"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="Import_Click" AutomationProperties.Name="匯入 Excel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="匯入 Excel"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="Export_Click" AutomationProperties.Name="匯出 Excel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="匯出 Excel"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                    <Button Style="{StaticResource GhostButton}" Click="FromHistory_Click" AutomationProperties.Name="加入出過的料"
                            ToolTip="把各工令出料紀錄裡出過、但倉庫還沒有的料號加進來">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="加入出過的料"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock x:Name="HeadingText" Text="大倉庫" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CountText" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- ===== 篩選 ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="520"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Padding="36,8,10,8" FontSize="14" TextChanged="Filter_Changed"
                         AutomationProperties.Name="搜尋物料" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="13,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleBrush}" IsHitTestVisible="False"/>
                <TextBlock Text="搜尋料號、名稱、規格（空格分開可以打好幾個關鍵字）" Margin="37,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <ComboBox x:Name="CategoryBox" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="Category_Changed"
                      AutomationProperties.Name="分類"/>
            <CheckBox x:Name="CheckedOnlyBox" Grid.Column="2" Content="只看已勾選" Margin="16,0,0,0" FontSize="13"
                      Checked="Filter_Changed" Unchecked="Filter_Changed" VerticalAlignment="Center"/>
            <TextBlock x:Name="ResultText" Grid.Column="3" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- ===== 清單與表單 ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12,12,6,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 右邊留捲軸的寬度（6），和清單的欄位對齊 -->
                    <Border Background="{DynamicResource InputBgBrush}" CornerRadius="10" Padding="10,8,6,8" Margin="0,0,6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="AllBox" VerticalAlignment="Center" Click="AllBox_Click" Focusable="False"
                                      ToolTip="勾選 / 取消勾選目前篩選出來的全部" AutomationProperties.Name="全選"/>
                            <TextBlock Grid.Column="1" Text="料號" Style="{StaticResource ColumnHeader}"/>
                            <TextBlock Grid.Column="2" Text="名稱" Style="{StaticResource ColumnHeader}"/>
                            <TextBlock Grid.Column="3" Text="規格" Style="{StaticResource ColumnHeader}"/>
                            <TextBlock Grid.Column="4" Text="單位" Style="{StaticResource ColumnHeader}"/>
                            <TextBlock Grid.Column="5" Text="分類" Style="{StaticResource ColumnHeader}"/>
                            <TextBlock x:Name="QuantityHeader" Grid.Column="6" Text="出料數量" Style="{StaticResource ColumnHeader}"
                                       Width="146" Margin="0" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="MaterialList" Grid.Row="1" Style="{StaticResource SideListStyle}"
                             ItemTemplate="{StaticResource MaterialTemplate}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.VerticalScrollBarVisibility="Visible"
                             SelectionChanged="MaterialList_SelectionChanged" MouseDoubleClick="MaterialList_MouseDoubleClick"
                             PreviewKeyDown="MaterialList_PreviewKeyDown" AutomationProperties.Name="物料清單"/>
                    <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxWidth="460" IsHitTestVisible="False"
                               LineHeight="22"/>
                </Grid>
            </Border>

            <!-- 新增 / 修改物料 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="FormTitle" Text="新增物料" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FormHint" Text="在左邊點一項可以修改。" FontSize="12" Foreground="{DynamicResource SubtleBrush}"
                                   Margin="0,4,0,4" TextWrapping="Wrap"/>
                        <TextBlock Text="料號" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="PartNoBox" Padding="10,8" FontSize="14" AutomationProperties.Name="料號"/>
                        <TextBlock Text="名稱" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="NameBox" Padding="10,8" FontSize="14" AutomationProperties.Name="名稱"/>
                        <TextBlock Text="規格" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="SpecBox" Padding="10,8" FontSize="14" AutomationProperties.Name="規格"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="單位" Style="{StaticResource FormLabel}"/>
                                <views:SuggestBox x:Name="UnitBox" Padding="10,8,34,8" FontSize="14" AutomationProperties.Name="單位"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="分類" Style="{StaticResource FormLabel}"/>
                                <views:SuggestBox x:Name="CategoryEditBox" Padding="10,8,34,8" FontSize="14" AutomationProperties.Name="物料分類"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="備註" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="NoteBox" Padding="10,8" FontSize="14" AutomationProperties.Name="物料備註"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" Padding="10,10" Click="Add_Click" AutomationProperties.Name="新增物料">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="新增"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Margin="5,0,0,0" Padding="10,10" Click="Save_Click" AutomationProperties.Name="儲存修改">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="儲存修改"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource DangerButton}" Margin="0,0,5,0" Padding="10,10" Click="Delete_Click" AutomationProperties.Name="刪除物料">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="刪除"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="5,0,0,0" Padding="10,10" Click="Clear_Click" AutomationProperties.Name="清空表單">
                                <TextBlock Text="清空"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== 底部 ===== -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <!-- 選料（從流程卡打開）：出料日期與加入 -->
            <StackPanel x:Name="PickFooter" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="出料日期" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <views:DateBox x:Name="PickDateBox" Width="150" Padding="10,8,34,8" FontSize="14" Margin="0,0,14,0"
                               AutomationProperties.Name="出料日期"/>
                <Button Click="Cancel_Click" Padding="22,10" Margin="0,0,10,0">
                    <TextBlock Text="取消"/>
                </Button>
                <Button x:Name="PickButton" Style="{StaticResource PrimaryButton}" Click="Pick_Click" Padding="22,10" AutomationProperties.Name="加入出料">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PickButtonText" Text="加入出料"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- 管理倉庫（從主視窗打開） -->
            <StackPanel x:Name="ManageFooter" DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="DeleteCheckedButton" Style="{StaticResource DangerButton}" Click="DeleteChecked_Click" Padding="16,10" Margin="0,0,10,0"
                        AutomationProperties.Name="刪除勾選的物料" IsEnabled="False">
                    <TextBlock x:Name="DeleteCheckedText" Text="刪除勾選的物料"/>
                </Button>
                <Button Click="Cancel_Click" Padding="22,10" AutomationProperties.Name="關閉">
                    <TextBlock Text="關閉"/>
                </Button>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
